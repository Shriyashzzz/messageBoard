<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini Message Board</title>
    <link rel="stylesheet"  type="text/css" href="/index.css">
  </head>
  <body>
    <header>
       <h1><%= title %></h1>
    </header>

    <main>
        <% messages.forEach((message, index)=>{ %>
           <article>
            <%- include('message', {message:message}); %>
            <form action="/message/<%= index+1 %>" method="POST" style="display:inline;">
              <button type="submit">Show More</button>
            </form>
           </article>
        <% }); %> 
      <button command = "show-modal" commandfor = "newMessage">
        New Message
      </button>
      <dialog id = "newMessage" >
        
        <form method="POST" action="/new">
          <div>
            <label for="userName">user</label>
            <input type="text" name = "userName" id = "userName" value <%= formData.userName || '' %>>
          </div>
          <div>
            <label for="textMessage">Message</label>
            <input type="text" name = "textMessage" id = "textMessage" required value= <%= formData.textMessage ||'' %> >
          </div>
          <div>
              <% if (errors.length !=0) { %>
                  <ul style = "list-style: none;">
                    <% errors.map((error) =>{ %>
                    <li style = "list-style: none;"> <%= error.msg %></li> 
                    <% }) %>
                  </ul>
              <% } %>
          </div>
        <div>
          <button type = "submit" >Send</button>
          <button type = "button" command = 'close' commandfor = "newMessage">Close</button>
        </div>
      
      </form> 


      </dialog>
      <% if (errors.length !== 0) { %>
        <script>
          document.getElementById("newMessage").showModal();
        </script>
      <% } %>

    </main>
   
  </body>
</html>
